# Публичный URL личного кабинета: тот же origin, что и сессия ЛК (CORS + credentials).
# Нужен для ссылок в UI и API ДЗ (GET/POST …/api/homework/…).
# Скопируйте в .env или задайте при сборке: VITE_LK_PUBLIC_URL=… npm run build
#
#   VITE_LK_PUBLIC_URL=https://lk.example.com
#   # локально, если ЛК на другом порту:
#   # VITE_LK_PUBLIC_URL=http://127.0.0.1:8001
#
# Устаревшее имя (если ещё используется): VITE_LK_URL
VITE_LK_PUBLIC_URL=http://127.0.0.1:8001
