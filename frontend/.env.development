# REACT_APP_API_URL намеренно не задан — запросы /api/... проксируются через setupProxy.js
# В package.json задано "homepage": "/app" — открывайте ЛК как http://localhost:3000/app/ (иначе 404 у manifest.json и др.).
# Если заходите через Django http://localhost:8001/app/, ссылки «Проверить» и fallback плеера ДЗ
# автоматически ведут на http://localhost:3000/app/... Или задайте явно:
# REACT_APP_CABINET_SPA_ORIGIN=http://localhost:3000
# Локально: Cabinet на 8001, 01 generator на 8000.
# Если join-url всё же приходит с origin ЛК — фронт перепишет на генератор (см. homeworkGeneratorNav.js).
# REACT_APP_CABINET_ORIGIN=http://localhost:8001
# WebSocket уведомлений: напрямую на Cabinet (прокси CRA с ws://localhost:3000 часто рвёт соединение).
REACT_APP_WS_URL=ws://localhost:8001
# Для прямого доступа к генератору (POST/GET создания и просмотра вариантов):
REACT_APP_GENERATOR_URL=http://127.0.0.1:8000
# Предпросмотр варианта: иначе по умолчанию https://генурок.рф (см. generatorVariantUrl.js)
REACT_APP_VARIANT_PREVIEW_ORIGIN=http://127.0.0.1:8000
