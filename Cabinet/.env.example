# Общий секрет кабинета ↔ генератор: POST /api/lesson/teacher-joined/ только с заголовком X-Lesson-Webhook-Secret.
# В проде обязателен (если не задан и DEBUG=False — вебхук вернёт 503). Локально при DEBUG=True можно не задавать.
# Обязательно в проде: тот же секрет в .env Генератора как LESSON_WEBHOOK_SECRET
# LESSON_WEBHOOK_SECRET=сгенерируйте_случайную_строку
# Ограничение размера JSON-тел запросов (МБ, по умолчанию 3)
# DATA_UPLOAD_MAX_MEMORY_MB=3
# Лимиты DRF (анонимные и авторизованные запросы к API)
# DRF_THROTTLE_USER=400/minute
# DRF_THROTTLE_ANON=60/minute

# Jitsi (ссылки на комнату кладутся в JWT для страницы урока на генераторе)
JITSI_BASE_URL=https://lesson.genurok.ru
#
# JWT-аутентификация на своём сервере Jitsi (учитель = организатор без входа в аккаунт Jitsi).
# JITSI_APP_ID     — значение appId в jitsi.cfg.lua (или Prosody config.lua) вашего сервера.
# JITSI_JWT_SECRET — значение appSecret из того же файла. Держите в секрете!
# Если не задано — JWT не генерируется (meet.jit.si, публичный сервер).
# JITSI_APP_ID=genurok
# JITSI_JWT_SECRET=ваш_секрет_из_jitsi_cfg_lua

# ── 404 вида /api/lesson/join/subtopics/ на генераторе ────────────────────────
# Неверный URL: к API подмешан путь страницы урока. Должно быть, например,
#   https://genurok.tw1.ru/api/subtopics/   (и /api/tasks/), а не .../lesson/join/subtopics/
# Исправление — во фронте генератора: база запросов = /api/ или полный API_URL, не pathname урока.

# Redis (WebSocket / channels в проде; пусто — InMemory)
