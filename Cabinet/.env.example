# Локальный runserver генератора (01 generator). Ссылки join/exam для ДЗ в DEBUG идут сюда по умолчанию.
LOCAL_GENUROK_URL=http://127.0.0.1:8000
# В DEBUG отдать ссылки ДЗ по GENUROK из этой строки: HOMEWORK_USE_ENV_GENUROK_URL=1
# Без DEBUG принудительно локальный генератор для ссылок ДЗ: FORCE_LOCAL_GENERATOR_LINKS=1
# После «Выйти»: по умолчанию FRONTEND_URL + /login/. Чтобы вести, например, на генератор:
# LOGOUT_REDIRECT_URL=https://lk-test.genurok.ru
