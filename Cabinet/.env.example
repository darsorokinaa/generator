# =============================================================================
# Скопируйте в .env на сервере. Для локальной разработки — свой .env или .env.local
# =============================================================================
#
# --- Обязательно в проде ---
# Уникальный ключ (python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=замените_на_случайную_строку
DEBUG=False
#
# Хосты Django (через запятую, без схемы): публичное имя ЛК и 127.0.0.1 для health-check с хоста
ALLOWED_HOSTS=lk.genurok.ru,127.0.0.1,localhost
#
# Публичный URL ЛК (схема + хост, без пути /app/). Должен совпадать с тем, что видит браузер.
# От него же автоматически дополняются CORS_ALLOWED_ORIGINS и CSRF_TRUSTED_ORIGINS, если забыли.
FRONTEND_URL=https://lk.genurok.ru
#
# Явно перечислите origins (через запятую). Для HTTPS-прода обязательно https://...
CORS_ALLOWED_ORIGINS=https://lk.genurok.ru
CSRF_TRUSTED_ORIGINS=https://lk.genurok.ru
#
# Если фронт и API на одном домене — этого достаточно. Доп. origin (например отдельный поддомен):
# CORS_ALLOWED_ORIGINS=https://lk.genurok.ru,https://app.genurok.ru
# CSRF_TRUSTED_ORIGINS=https://lk.genurok.ru,https://app.genurok.ru
#
# Корень сайта генератора (уроки/варианты), не URL Cabinet
GENUROK_URL=https://genurok.ru
#
# После «Выйти»: по умолчанию {FRONTEND_URL}/login/
# LOGOUT_REDIRECT_URL=https://lk.genurok.ru/login/
#
# Редирект после входа (редко нужен): по умолчанию / на том же хосте
# LOGIN_REDIRECT_URL=https://lk.genurok.ru/
#
# Если в FRONTEND_URL случайно https, а нужен http: FRONTEND_URL_FORCE_HTTP=1
# FRONTEND_URL_FORCE_HTTP=1
#
# Локальный runserver генератора (только dev)
LOCAL_GENUROK_URL=http://127.0.0.1:8000
# В DEBUG ссылки ДЗ по GENUROK из .env: HOMEWORK_USE_ENV_GENUROK_URL=1
# Без DEBUG не использовать локальный генератор для ссылок: не ставьте FORCE_LOCAL_GENERATOR_LINKS
#
LESSON_SECRET=сгенерируйте_и_пропишите_тот_же_на_генераторе
# Обязательно в проде — тот же секрет в .env генератора (POST от генератора в ЛК)
LESSON_WEBHOOK_SECRET=сгенерируйте_случайную_строку

# JITSI_BASE_URL=https://lesson.genurok.ru
# JITSI_APP_ID=
# JITSI_JWT_SECRET=
#
# VK ID — вход на /login/ через ВКонтакте (учитель). В консоли VK задайте тот же redirect, что и VKID_REDIRECT_URL.
# VKID_APP_ID=54547643
# VKID_REDIRECT_URL=https://lk.genurok.ru/login/
# Права токена (почта для сопоставления с учёткой): по умолчанию email
# VKID_SCOPE=email

# Redis (WebSocket / channels в проде; пусто — InMemory, не для нескольких воркеров)
# REDIS_URL=redis://127.0.0.1:6379/0

# --- За обратным прокси (Nginx TLS) ---
# Доверять X-Forwarded-Host / X-Forwarded-Proto (по умолчанию True при DEBUG=False)
# USE_X_FORWARDED_HOST=True
# Формат: имя_заголовка,ожидаемое_значение
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# Если прокси уже отдаёт HTTPS клиенту, а Django видит HTTP — оставьте как выше.
# Если редирект HTTP→HTTPS делает только прокси, выключите редирект в Django:
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=0

# --- PostgreSQL (ЛК): без DB_PASSWORD Django поднимет SQLite (только dev) ---
DB_NAME=lk_cabinet
DB_USER=lk_user
DB_PASSWORD=StrongPass123lk
DB_HOST=prod-db.internal
DB_PORT=5432

# --- PostgreSQL генератора (опционально, только чтение; пустой GEN_DB_PASSWORD — отключено) ---
# Те же креды, что у боевой БД генератора
# GEN_DB_NAME=generatordb
# GEN_DB_USER=postgres
# GEN_DB_PASSWORD=
# GEN_DB_HOST=prod-gen-db.internal
# GEN_DB_PORT=5432

# MEDIA_ROOT=/var/lib/cabinet/media

# DATA_UPLOAD_MAX_MEMORY_MB=3
# DRF_THROTTLE_USER=400/minute
# DRF_THROTTLE_ANON=60/minute
