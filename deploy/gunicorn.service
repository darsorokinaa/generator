[Unit]
Description=Генератор ЕГЭ/ОГЭ — Daphne ASGI (HTTP + WebSocket уроков)
After=network.target postgresql.service
# С Redis-слоем каналов раскомментируйте: Wants=redis.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/generator_test/Generator

RuntimeDirectory=generator_test
LogsDirectory=generator_test

# WSGI (Gunicorn) не обрабатывает WebSocket: комната урока (/ws/lesson/…) не работает.
# Нужен ASGI — Daphne, иначе ученик не получает вариант и fetch к API не вызывается / падает по таймауту.
ExecStart=/opt/generator_test/venv/bin/python3 -m daphne \
    -b 127.0.0.1 \
    -p 8002 \
    --access-log - \
    --proxy-headers \
    Generator.asgi:application

Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PGDATABASE=generatordb"
Environment="PGUSER=generator_user"
Environment="PGPASSWORD=StrongPass123"
Environment="PGHOST=localhost"
Environment="PGPORT=5432"
Environment="DJANGO_SETTINGS_MODULE=Generator.settings"
Environment="DEBUG=false"
Environment="SECRET_KEY=WNbG1HzC4_lta5i_vvh6TPK3_G33Xlhzlr167fDXCFd_CVc0fS72WcaWvtLXwHreDpo"
Environment="CSRF_TRUSTED_ORIGINS=http://genurok.tw1.ru,https://genurok.tw1.ru"
Environment="LK_PUBLIC_URL=https://lk.genurok.tw1.ru"
# Куда открывать ЛК по кнопке (дашборд). Пример: https://lk.genurok.tw1.ru/dashboard
# Environment="LK_DASHBOARD_URL=https://lk.genurok.tw1.ru/dashboard"
# Пароль для кнопки «Личный кабинет»: если не задать — в коде по умолчанию 100326.
# На проде лучше задать только на сервере (не коммитить): Environment="LK_NAVIGATION_PASSWORD=..."
# Отключить проверку: Environment="LK_NAVIGATION_PASSWORD="
# Тестовый стенд часто без Redis — in-memory каналы (один процесс Daphne). С Redis — удалите эту строку.
Environment="CHANNEL_LAYER_BACKEND=inmemory"
Environment="LESSON_SECRET=eKPoaKBpV0QeRzYi3YWUV3gBNfWamBmGwK5MgLWvSoKmenpLVQGf7s0"

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
