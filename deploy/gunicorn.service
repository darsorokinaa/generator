[Unit]
Description=Генератор ЕГЭ/ОГЭ — Gunicorn (тестовый сервер)
After=network.target postgresql.service

[Service]
User=generator_test
Group=generator_test
WorkingDirectory=/opt/generator_test/Generator

RuntimeDirectory=generator_test
LogsDirectory=generator_test

ExecStart=/opt/generator_test/venv/bin/gunicorn \
    --workers=3 \
    --timeout=120 \
    --bind=127.0.0.1:8000 \
    --access-logfile=/var/log/generator_test/access.log \
    --error-logfile=/var/log/generator_test/error.log \
    Generator.wsgi:application

Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PGDATABASE=generatordb_test"
Environment="PGUSER=generatoruser_test"
Environment="PGPASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ"
Environment="PGHOST=localhost"
Environment="PGPORT=5432"
Environment="DJANGO_SETTINGS_MODULE=Generator.settings"
Environment="DEBUG=false"
Environment="SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_КЛЮЧ"
Environment="CSRF_TRUSTED_ORIGINS=https://ВАШ_ДОМЕН.ru,https://www.ВАШ_ДОМЕН.ru"

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
