# Django / Cabinet
Cabinet/db.sqlite3
Cabinet/staticfiles/
Cabinet/**/__pycache__/
*.py[cod]

# Секреты и локальные env (в репозитории остаётся только Cabinet/.env.example)
Cabinet/.env
Cabinet/.env.*
!Cabinet/.env.example

# venv (если в корне репозитория)
venv/
.venv/

# Корневой .env, если появится
.env
.env.*
!.env.example

# Nginx (конфиги содержат пути, пароли и серверную специфику)
nginx.conf
nginx.conf.*
nginx/
*.nginx
